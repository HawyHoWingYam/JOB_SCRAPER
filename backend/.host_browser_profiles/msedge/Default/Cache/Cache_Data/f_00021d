s.hk/article/45307/%E9%8A%80%E8%A1%8C%E5%88%86%E8%A1%8C%E9%81%8B%E4%BD%9C%E7%B6%93%E7%90%86%E5%85%A5%E8%A1%8C-%E8%81%B7%E8%B2%AC-%E5%85%A5%E8%A1%8C%E6%A2%9D%E4%BB%B6-%E6%99%89%E5%8D%87%E9%81%93%E8%B7%AF-%E5%B8%B8%E8%A6%8B%E5%95%8F%E9%A1%8C","isPaid":false,"isVideo":false,"videoLength":null,"channelId":"007","startPublishDate":"2026-05-12T22:28:47+00:00"},"job":null,"isViewed":false,"isActive":true}]},"adv":null},{"bubble":{"storyType":{"id":8,"name":"Top RM Jobs","nameForUrl":"top-rm-jobs","icon":"https://res04.ctgoodjobs.hk/images/feature/story-bubble-top-jobs.webp","moreUrl":"https://jobs.ctgoodjobs.hk/jobs/relationship-manager-jobs?company_id=00027929,00013470,00014172,00017331,00070340,00006546,00015141,00002330,00028944,00001885,00082728,00021858,00027159,00045768,00025648,00015309,00025792,00002381,00014158,00008297,00031264,00037695,00018713","contentTypes":[{"id":3,"name":"Job"}]},"hasUnviewed":true,"total":15,"stories":[{"storyId":235179,"name":"SVP, Corporate Banking - Mainland Corporates - Hang Seng Bank (HK)","createDate":"2026-05-13T01:30:22.276049","postDate":"2026-05-13T13:00:20.134689","article":null,"job":{"jobId":"10107829","jobTitle":"SVP, Corporate Banking - Mainland Corporates - Hang Seng Bank (HK)","companyName":"Hang Seng Bank","companyLogo":"https://res04.ctgoodjobs.hk/images/company/hang-seng-bank_7_z.gif","companyBanner":"https://res04.ctgoodjobs.hk/images/company_banner/jobdetails/hang-seng-bank_1.jpg","url":"https://jobs.ctgoodjobs.hk/job/10107829/svp-corporate-banking-mainland-corporates-hang-seng-bank-hk","content":"<p><strong>Some careers have more impact than others.</strong><br />\r\n\u00A0<br />\r\nIf you’re looking for a role where you can continue to make an impression, take the next step at Hang Seng where your contributions will always be valued.</p>\r\n\r\n<p><strong>Commercial Banking - Mainland Corporates\u00A0</strong></p>\r\n\r\n<p>Hang Seng’s Commercial Banking (CMB) business provides customized one-stop financial solutions to our corporate customers, from prime small and medium-sized businesses to publicly listed companies.\u00A0</p>\r\n\r\n<p>For customers conducting business locally or around the world, we offer a comprehensive range of services including corporate lending, trade and receivables finance, structured loan, cash management, investment, treasury services, insurance and e-Banking services.\u00A0\u00A0As a reliable financial partner, we attend to the specific business needs of our customers and provide efficient tailor-made banking solutions through our relationship managers and dedicated specialists.</p>\r\n\r\n<p>We are currently seeking a high caliber professional to join our team as\u00A0SVP, Corporate Banking – Mainland Corporates, reporting to Division Head, Corporate Banking - Mainland Corporates.</p>\r\n\r\n<p><strong>Principal responsibilities</strong></p>\r\n\r\n<ul>\r\n\t<li>Deepen client relationships and improve income generation through focused business development activities;</li>\r\n\t<li>Cover and develop Chinese SOE portfolio as well as POE clients;</li>\r\n\t<li>Negotiate and structure credit facilities and prepare credit proposals (new and review) in a timely and professional manner, under the constraints of credit / lending policies, in meeting clients' needs as a result of thorough understanding of their businesses, financing requirements and market conditions;</li>\r\n\t<li>Improve the loan portfolio mix and maintain the loan assets at quality level by conducting credit assessment of customers' financing requests in a professional manner and by monitoring credit risks and customers' credit standing regularly and then act promptly and appropriately;</li>\r\n\t<li>Expand customer base in order to increase the Bank’s market share in the segment;</li>\r\n\t<li>Prepare facilities documentation in accordance with credit approvals and market standards;\u00A0</li>\r\n\t<li>Manage operational risks, including identification, assessment, mitigation and controls;</li>\r\n\t<li>Carry out sales and marketing of non-lending banking products with an objective to maximize the Bank’s profitability;</li>\r\n\t<li>To be both an independent contributor and, as the case may be, a people manager in supervising and providing coaching to a Relationship Officer on both marketing and credit capabilities</li>\r\n</ul>\r\n\r\n<p><strong>Requirements</strong></p>\r\n\r\n<ul>\r\n\t<li>University degree in Business Management, Banking, Finance, related discipline or other relevant qualifications;</li>\r\n\t<li>Proven experience in coverage banker experience in dealing with China Corporates\u00A0 with proven business track record;</li>\r\n\t<li>License holder of securities (HKSI) and insurance (IIQE) and fulfillment of the competency requirements to carry out regulated activities as defined under the Securities and Futures Ordinance and Insurance Ordinance strongly desired;</li>\r\n\t<li>Sound credit analytical skills and profound knowledge in various commercial banking products</li>\r\n\t<li>Strong growth mind set, ability to lead change and strategic transformation, overcome challenges, create new and innovative solutions and work in an agile environment.</li>\r\n\t<li>Open to change with ability to influence, engage and lead positively and in an inspiring manner\u00A0</li>\r\n\t<li>Proficiency in both English and Chinese, native mandarin strong preferred, and fluent in Cantonese preferred.</li>\r\n\t<li>High level of customer centricity mindset with dedication to deliver exceptional quality services for customers.</li>\r\n\t<li>Professional qualifications such as Enhanced Competency Framework (ECF) and/or Certified Banker (CB) under Hong Kong Institute of Bankers (HKIB) would be an advantage</li>\r\n</ul>\r\n\r\n<p>The employment is subject to Mandatory Reference Checking Scheme (MRCS) as per regulatory requirement. For details, please refer to\u00A0Hong Kong Monetary Authority - Mandatory Reference Checking Scheme.</p>\r\n<p>You’ll ach