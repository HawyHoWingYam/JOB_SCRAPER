FROM python:3.11-slim

WORKDIR /app

# Install runtime libs required by Playwright Chromium on Debian slim.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
COPY requirements-dev.txt .

RUN pip install --no-cache-dir -r requirements-dev.txt \
    && python -m playwright install chromium

COPY . .

ENV WORKER_NAME=worker

CMD ["python", "-c", "import os, time; print(f'Starting {os.environ.get(\"WORKER_NAME\", \"worker\")}'); time.sleep(3600)"]
