# ============================================
# Database Configuration
# ============================================
# For local development (without Docker)
DATABASE_URL=postgresql://admin:dev_password@localhost:5433/jobsdb

# For Docker Compose
POSTGRES_DB=jobsdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=dev_password

# ============================================
# Redis Configuration
# ============================================
# For local development (without Docker)
REDIS_URL=redis://localhost:6379/0

# ============================================
# LLM Services Configuration
# ============================================
# Options: anthropic, claude, custom, gemini, zhipu, mock
LLM_PROVIDER=custom

# Google Gemini API
# Used only when LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Custom LLM Provider
# Used only when LLM_PROVIDER=custom
# Default example: DeepSeek Anthropic-compatible API
CUSTOM_API_KEY=your_deepseek_key_here
CUSTOM_BASE_URL=https://api.deepseek.com/anthropic
CUSTOM_API_FORMAT=anthropic
CUSTOM_MODEL=deepseek-v4-flash
# Alternative Anthropic-compatible relay:
# CUSTOM_BASE_URL=https://code.newcli.com/claude/aws
# CUSTOM_MODEL=claude-sonnet-4-5
# Use CUSTOM_API_FORMAT=openai_responses only for a Responses-compatible proxy.

# Anthropic Claude API
# Used only when LLM_PROVIDER=anthropic or LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=

# Zhipu AI API
# Used only when LLM_PROVIDER=zhipu
ZHIPU_API_KEY=your_zhipu_key_here

# ============================================
# Google Custom Search Configuration
# ============================================
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# ============================================
# Application Configuration
# ============================================
DEBUG=true
# Optional override for API runtime reload behavior.
# When unset, direct `python -m app.<service>` runs fall back to DEBUG.
# UVICORN_RELOAD=false
# When reload is enabled in Docker, polling is more stable than native watchfiles
# on bind-mounted source directories.
# UVICORN_RELOAD_FORCE_POLLING=true
# JobsDB headed browser runtime (used by the local host-side headed crawl worker)
JOBSDB_HEADED_BROWSER_CHANNEL=msedge
# Recommended: dedicate a separate profile directory and complete any anti-bot challenge once.
# JOBSDB_HEADED_BROWSER_USER_DATA_DIR=C:\Users\<you>\AppData\Local\job_scraper\playwright\msedge
# Optional when channel lookup is not enough:
# JOBSDB_HEADED_BROWSER_EXECUTABLE_PATH=
# JOBSDB_HEADED_NAVIGATION_TIMEOUT_MS=60000
# Prevent two headed workers from launching against the same browser profile.
# JOBSDB_HEADED_WORKER_LOCK_PORT=47651
# CTGoodJobs proxy runtime
# Enable this for both CTGoodJobs headless fetches and fresh-profile headed browser sessions.
# CTGOODJOBS_PROXY_ENABLED=false
# Options: static, pool_api
# CTGOODJOBS_PROXY_PROVIDER=static
# For commercial/static endpoints:
# CTGOODJOBS_PROXY_STATIC_URL=http://username:password@proxy-host:port
# For local pool APIs compatible with /get and optional /delete:
# CTGOODJOBS_PROXY_POOL_API_BASE_URL=http://127.0.0.1:5010
# CTGOODJOBS_PROXY_POOL_GET_PATH=/get
# CTGOODJOBS_PROXY_POOL_DELETE_PATH=/delete
# CTGOODJOBS_PROXY_REQUEST_TIMEOUT_S=30
# CTGOODJOBS_PROXY_QUARANTINE_MINUTES_CHALLENGE=15
# CTGOODJOBS_PROXY_QUARANTINE_MINUTES_NETWORK=10
# CTGOODJOBS_PROXY_MIN_SECONDS_BETWEEN_REUSE=0
# CTGOODJOBS_PROXY_REQUIRE_HTTPS_CAPABLE=false
# Optional literal header line forwarded to proxy requests / pool API calls:
# CTGOODJOBS_PROXY_PROVIDER_AUTH_HEADER=Proxy-Authorization: Basic <token>
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# Taxonomy Governance Thresholds
# ============================================
# AI-created taxonomy nodes start hidden.
# They become filter-visible only after distinct_job_count reaches the threshold.
FILTER_SKILL_L3_MIN_JOBS=5
FILTER_SKILL_L2_MIN_JOBS=10
FILTER_SKILL_L1_MIN_JOBS=20
FILTER_JOB_L3_MIN_JOBS=5
FILTER_JOB_L2_MIN_JOBS=10
FILTER_JOB_L1_MIN_JOBS=20

# ============================================
# Frontend Configuration
# ============================================
# For local development
VITE_API_URL=http://localhost:8000
