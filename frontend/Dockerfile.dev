FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including platform-specific rollup binary)
RUN npm install && npm install @rollup/rollup-linux-arm64-musl --save-optional

# Remove any host-generated build artifacts that may persist across cached layers.
RUN rm -rf dist .vite-*.out .vite-*.err

# Copy application code
COPY . .

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:5173 || exit 1

# Run Vite dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
